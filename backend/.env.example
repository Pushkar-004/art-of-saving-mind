# ── Server ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5001
CORS_ORIGIN=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# ── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/ppm

# ── Auth ────────────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me-too
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
PASSWORD_RESET_TOKEN_EXPIRES_MINUTES=30
BCRYPT_SALT_ROUNDS=10

# ── SMTP / Outbound email (required for booking confirmation, payment, and ──
# reminder emails to be sent — without these, the app runs fine but every
# email is skipped and logged as a warning instead of sent) ─────────────────
# All five must be set together for email to be enabled.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@artofsavingmind.com

# Examples:
#   Gmail (use an App Password, not your account password):
#     SMTP_HOST=smtp.gmail.com
#     SMTP_PORT=587
#     SMTP_USER=you@gmail.com
#     SMTP_PASS=<16-char app password>
#   SendGrid:
#     SMTP_HOST=smtp.sendgrid.net
#     SMTP_PORT=587
#     SMTP_USER=apikey
#     SMTP_PASS=<SendGrid API key>
#   Mailtrap (dev/testing — emails never leave the sandbox):
#     SMTP_HOST=sandbox.smtp.mailtrap.io
#     SMTP_PORT=587
#     SMTP_USER=<mailtrap inbox user>
#     SMTP_PASS=<mailtrap inbox pass>

# ── AI wellness assistant (optional) ───────────────────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ── Razorpay Payment Gateway (optional) ────────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

