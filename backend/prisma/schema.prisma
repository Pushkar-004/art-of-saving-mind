generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id             String   @id @default(uuid())
  name           String
  email          String   @unique
  passwordHash   String   @map("password_hash")
  phone          String?
  role           Role     @default(patient)
  isActive       Boolean  @default(true) @map("is_active")
  avatarInitials String?  @map("avatar_initials")
  language       Language @default(en)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  assignedAppointments   Appointment[] @relation("AssignedPsychologist")
  assignedByAppointments Appointment[] @relation("AssignedByAdmin")

  notifications       Notification[]
  passwordResetTokens PasswordResetToken[]
  patient             Patient?
  verifiedPayments    Payment[]            @relation("PaymentVerifier")
  uploadedResources   Resource[]
  sessionNotesWritten SessionNote[]

  @@map("users")
}

model Patient {
  id               String            @id @default(uuid())
  userId           String            @unique @map("user_id")
  primaryConcern   String?           @map("primary_concern")
  status           PatientStatus     @default(new)
  joinedDate       DateTime          @default(now()) @map("joined_date")
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")
  appointments     Appointment[]
  emergencyContact EmergencyContact?
  medicalHistory   MedicalHistory?
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionNotes     SessionNote[]

  @@map("patients")
}

model MedicalHistory {
  id          String   @id @default(uuid())
  patientId   String   @unique @map("patient_id")
  conditions  Json     @default("[]")
  medications Json     @default("[]")
  allergies   Json     @default("[]")
  updatedAt   DateTime @updatedAt @map("updated_at")
  patient     Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@map("medical_history")
}

model EmergencyContact {
  id           String  @id @default(uuid())
  patientId    String  @unique @map("patient_id")
  name         String
  relationship String
  phone        String
  email        String?
  patient      Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@map("emergency_contacts")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model AvailabilitySlot {
  id        String    @id @default(uuid())
  dayOfWeek DayOfWeek @map("day_of_week")
  startTime String    @map("start_time")
  endTime   String    @map("end_time")
  isEnabled Boolean   @default(true) @map("is_enabled")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@index([dayOfWeek])
  @@map("availability_slots")
}

model BlockedDate {
  id        String   @id @default(uuid())
  date      DateTime @unique @db.Date
  label     String?
  createdAt DateTime @default(now()) @map("created_at")

  @@map("blocked_dates")
}

model Appointment {
  id                 String            @id @default(uuid())
  patientId          String?           @map("patient_id")
  guestName          String?           @map("guest_name")
  guestEmail         String?           @map("guest_email")
  guestPhone         String?           @map("guest_phone")
  service            String
  date               DateTime          @db.Date
  startTime          String            @map("start_time")
  endTime            String            @map("end_time")
  mode               AppointmentMode   @default(online)
  status             AppointmentStatus @default(pending)
  notes              String?
  cancellationReason String?           @map("cancellation_reason")
  reminderSent       Boolean           @default(false) @map("reminder_sent")
  createdAt          DateTime          @default(now()) @map("created_at")
  updatedAt          DateTime          @updatedAt @map("updated_at")

  assignedPsychologistId String? @map("assigned_psychologist_id")
  assignedPsychologist   User?   @relation("AssignedPsychologist", fields: [assignedPsychologistId], references: [id])

  assignedByAdminId String? @map("assigned_by_admin_id")
  assignedByAdmin   User?   @relation("AssignedByAdmin", fields: [assignedByAdminId], references: [id])

  patient     Patient?     @relation(fields: [patientId], references: [id])
  payment     Payment?
  sessionNote SessionNote?

  @@index([patientId])
  @@index([date])
  @@index([assignedPsychologistId])
  @@map("appointments")
}

model Notification {
  id                   String           @id @default(uuid())
  recipientId          String           @map("recipient_id")
  type                 NotificationType
  title                String
  message              String
  relatedAppointmentId String?          @map("related_appointment_id")
  isRead               Boolean          @default(false) @map("is_read")
  createdAt            DateTime         @default(now()) @map("created_at")
  updatedAt            DateTime         @updatedAt @map("updated_at")
  recipient            User             @relation(fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([recipientId])
  @@index([recipientId, isRead])
  @@map("notifications")
}

model Resource {
  id           String           @id @default(uuid())
  title        String
  description  String?
  category     ResourceCategory
  fileUrl      String           @map("file_url")
  fileName     String           @map("file_name")
  thumbnailUrl String?          @map("thumbnail_url")
  isPublished  Boolean          @default(true) @map("is_published")
  uploadedBy   String           @map("uploaded_by")
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")
  uploader     User             @relation(fields: [uploadedBy], references: [id], onDelete: Cascade)

  @@index([category])
  @@index([uploadedBy])
  @@index([isPublished])
  @@map("resources")
}

model SessionNote {
  id               String      @id @default(uuid())
  appointmentId    String      @unique @map("appointment_id")
  therapistId      String      @map("therapist_id")
  patientId        String      @map("patient_id")
  diagnosisSummary String?     @map("diagnosis_summary")
  observations     String?
  recommendations  String?
  homework         String?
  nextGoals        String?     @map("next_goals")
  createdAt        DateTime    @default(now()) @map("created_at")
  updatedAt        DateTime    @updatedAt @map("updated_at")
  appointment      Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  patient          Patient     @relation(fields: [patientId], references: [id], onDelete: Cascade)
  therapist        User        @relation(fields: [therapistId], references: [id], onDelete: Cascade)

  @@index([therapistId])
  @@index([patientId])
  @@map("session_notes")
}

model Payment {
  id                   String        @id @default(uuid())
  appointmentId        String        @unique @map("appointment_id")
  status               PaymentStatus @default(pending)
  screenshotUrl        String?       @map("screenshot_url")
  transactionReference String?       @map("transaction_reference")
  remarks              String?
  verifiedById         String?       @map("verified_by_id")
  verifiedAt           DateTime?     @map("verified_at")
  createdAt            DateTime      @default(now()) @map("created_at")
  updatedAt            DateTime      @updatedAt @map("updated_at")
  appointment          Appointment   @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  verifiedBy           User?         @relation("PaymentVerifier", fields: [verifiedById], references: [id])

  @@index([status])
  @@map("payments")
}

model PaymentSettings {
  id                  String   @id @default("default")
  clinicName          String   @default("Art of Saving Mind") @map("clinic_name")
  upiId               String   @default("8766804788@ybl") @map("upi_id")
  qrImageUrl          String?  @map("qr_image_url")
  paymentInstructions String?  @map("payment_instructions")
  updatedAt           DateTime @updatedAt @map("updated_at")

  @@map("payment_settings")
}

enum Role {
  patient
  admin
  psychologist
}

enum PatientStatus {
  active
  inactive
  new
}

enum Language {
  en
  hi
  mr
}

enum AppointmentStatus {
  pending
  upcoming
  completed
  cancelled
}

enum AppointmentMode {
  online
  offline
}

enum DayOfWeek {
  sunday
  monday
  tuesday
  wednesday
  thursday
  friday
  saturday
}

enum NotificationType {
  appointment_booked
  appointment_confirmed
  appointment_cancelled
  appointment_rescheduled
  general_admin
}

enum ResourceCategory {
  worksheet
  meditation
  exercise
  guide
  pdf
}

enum PaymentStatus {
  pending
  verified
  rejected
}
